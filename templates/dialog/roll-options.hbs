<div class="zc-roll-options">
  <p class="zc-roll-code">Code : <strong>{{code}}</strong></p>
  {{#if fixedDifficulty}}
  <p class="zc-roll-code">Difficulté : <strong>{{fixedDifficulty}}</strong></p>
  {{else if isTest}}
  <div class="form-group">
    <label>Difficulté</label>
    <select name="difficulty">{{selectOptions difficulties}}</select>
  </div>
  <div class="form-group">
    <label>ou valeur libre</label>
    <input type="number" name="customDifficulty" min="0" placeholder="—">
  </div>
  {{/if}}
  <div class="form-group">
    <label>Modificateur en dés</label>
    <input type="number" name="diceMod" value="0" step="1">
  </div>
  <div class="form-group">
    <label>Modificateur fixe</label>
    <input type="number" name="flatMod" value="0" step="1">
  </div>
  {{#if woundPenalty}}
  <div class="form-group">
    <label>Malus de blessure ({{woundLabel}} : -{{woundPenalty}}D)</label>
    <input type="checkbox" name="applyWound" {{#if isTest}}checked{{/if}}>
  </div>
  {{/if}}
  {{#if hasResources}}
  <div class="form-group">
    <label>Points de personnage (+1D chacun, max {{cpMax}}, {{cpAvailable}} dispo.)</label>
    <input type="number" name="cp" value="0" min="0" max="{{cpMax}}">
  </div>
  {{#if allowCojones}}
  <div class="form-group">
    <label>Point de Cojones : double dés et tiers ({{cojonesAvailable}} dispo.)</label>
    <input type="checkbox" name="cojones" {{#unless cojonesAvailable}}disabled{{/unless}}>
  </div>
  <p class="zc-hint">Points de personnage et Cojones ne se cumulent pas sur un même jet.</p>
  {{/if}}
  {{/if}}
</div>
