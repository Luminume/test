<div class="zc-sheet zc-pnj">
  <header class="zc-top">
    <div class="zc-portrait-frame small">
      <img class="zc-portrait small" src="{{actor.img}}" alt="" {{#if editable}}data-action="editPortrait" data-tooltip="Changer l'image"{{/if}}>
      <button type="button" class="zc-show-portrait" data-action="showPortrait" data-tooltip="Montrer l'image aux joueurs">
        <i class="fa-solid fa-display"></i>
      </button>
    </div>
    <div class="zc-identity">
      <label class="zc-field grow">Nom <input type="text" name="name" value="{{actor.name}}"></label>
      <div class="zc-row">
        <label class="zc-field">Bonus aux dégâts <input type="text" name="system.damageBonus" value="{{system.damageBonus}}" placeholder="{{system.damageBonusAuto}}"></label>
        <label class="zc-field">Déplacement <input type="text" name="system.movement" value="{{system.movement}}" placeholder="{{system.movementAuto}}"></label>
      </div>
      <div class="zc-row">
        <label class="zc-field zc-inline" data-tooltip="Morts-vivants : aucun malus de blessure sur les jets">
          <input type="checkbox" name="system.painless" {{checked system.painless}}> Insensible à la douleur
        </label>
        <label class="zc-field zc-inline" data-tooltip="Un seul jet pour le groupe, +5 toutes les N créatures au-delà de la première ; chaque niveau de blessure en élimine environ 20 %">
          <input type="checkbox" name="system.horde.enabled" {{checked system.horde.enabled}}> Horde
        </label>
        {{#if system.horde.enabled}}
        <label class="zc-field small">Nombre <input type="number" min="0" name="system.horde.count" value="{{system.horde.count}}"></label>
        <label class="zc-field small" data-tooltip="+5 toutes les N créatures">+5 / <input type="number" min="1" name="system.horde.per" value="{{system.horde.per}}"></label>
        <span class="zc-horde-bonus">+{{system.hordeBonus}}</span>
        {{/if}}
      </div>
    </div>
  </header>

  <div class="zc-columns">
    <div class="zc-attributes">
      {{#each attributeBlocks as |block|}}
      <section class="zc-attr">
        <header class="zc-band">
          <a class="zc-roll-link" data-action="rollAttribute" data-attribute="{{block.key}}">{{block.label}}</a>
          <input class="zc-code{{#unless block.attr.valid}} invalid{{/unless}}" type="text"
                 name="system.attributes.{{block.key}}.code" value="{{block.attr.code}}">
        </header>
        <ol class="zc-skills">
          {{#each block.custom as |skill|}}
          <li class="zc-skill trained custom" data-item-id="{{skill.id}}">
            <span></span>
            <a class="zc-roll-link" data-action="rollCustomSkill">{{skill.name}}</a>
            <input class="zc-code{{#unless skill.valid}} invalid{{/unless}}" type="text"
                   data-item-field="system.bonus" value="{{skill.bonus}}">
            <span class="zc-total">{{skill.total}}</span>
            <span class="zc-controls">
              <a data-action="itemDelete" data-tooltip="Supprimer"><i class="fa-solid fa-trash"></i></a>
            </span>
          </li>
          {{/each}}
          {{#if @root.editable}}
          <li class="zc-add">
            <a data-action="itemCreate" data-type="competence" data-attribute="{{block.key}}"><i class="fa-solid fa-plus"></i> Compétence</a>
          </li>
          {{/if}}
        </ol>
      </section>
      {{/each}}
    </div>

    <aside class="zc-side">
      <label class="zc-field zc-inline" data-tooltip="Profil du bestiaire de la campagne (Péchés, Anciens) : Points de Vie et seuils de blessure">
        <input type="checkbox" name="system.hp.enabled" {{checked system.hp.enabled}}> Profil PV
      </label>
      {{#if system.hp.enabled}}
      <section class="zc-box zc-hp">
        <h3>Points de Vie</h3>
        <div class="zc-row">
          <label class="zc-field small">PV <input type="number" min="0" name="system.hp.value" value="{{system.hp.value}}"></label>
          <label class="zc-field small">/ <input type="number" min="0" name="system.hp.max" value="{{system.hp.max}}"></label>
        </div>
        <label class="zc-field" data-tooltip="Dégâts cumulés : 1er seuil -1D, 2e seuil -2D, 3e seuil hors combat">Seuils
          <input type="text" name="system.hp.thresholds" value="{{system.hp.thresholds}}" placeholder="8/16/24"></label>
        <p class="zc-hp-state zc-hp-{{system.hp.level}}">{{system.hp.label}} <span class="zc-hint">({{system.hp.taken}} dégâts)</span></p>
        <button type="button" data-action="takeDamage"><i class="fa-solid fa-heart-crack"></i> Encaisser des dégâts</button>
      </section>
      {{else}}
      <section class="zc-box zc-wounds">
        <h3>Niveaux de blessures</h3>
        <ul>
          {{#each wounds as |w|}}
          <li class="{{#if w.checked}}checked{{/if}}{{#if w.current}} current{{/if}}" data-tooltip="{{w.effect}}">
            <a class="zc-check" data-action="setWound" data-level="{{w.level}}"></a>
            <span class="zc-range">{{w.range}}</span>
            <span class="zc-label">{{w.label}}</span>
            <span class="zc-penalty">{{w.penaltyLabel}}</span>
          </li>
          {{/each}}
        </ul>
        <button type="button" data-action="takeDamage"><i class="fa-solid fa-heart-crack"></i> Encaisser des dégâts</button>
      </section>
      {{/if}}
    </aside>
  </div>

  {{#if showPowers}}
  <section class="zc-box">
    <header class="zc-band"><span>Pouvoirs occultes</span></header>
    <div class="zc-occult">
      {{> "systems/zcorps-vtt/templates/actor/parts/powers.hbs"}}
    </div>
  </section>
  {{/if}}

  {{> "systems/zcorps-vtt/templates/actor/parts/weapons.hbs"}}

  <section class="zc-box">
    <header class="zc-band"><span>Notes</span></header>
    <textarea name="system.notes" rows="5">{{system.notes}}</textarea>
  </section>
</div>
